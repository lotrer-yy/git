extends SceneTree
var failures: Array[String] = []
var shots: int = 0
func _initialize(): run.call_deferred()
func check(ok: bool,message: String):
    if not ok:
        failures.append(message)
        push_error(message)
func advance(enemy: Node,seconds: float):
    for i in ceili(seconds/.01): enemy._physics_process(.01)
func run():
    root.size = Vector2i(1152,648)
    var player := CharacterBody2D.new()
    root.add_child(player)
    var camera := Camera2D.new()
    root.add_child(camera)
    camera.make_current()
    camera.force_update_scroll()
    var enemy = load("res://scenes/enemies/ocean_octopus.tscn").instantiate()
    root.add_child(enemy)
    enemy.configure(player,camera)
    enemy.enabled = true
    enemy.automatic_spawning = false
    enemy.set_physics_process(false)
    enemy.ink_sprayed.connect(func():shots+=1)
    enemy._appear(Vector2(-180,-120))
    player.position = Vector2(5000,5000)
    player.position = Vector2(5000,5000)
    advance(enemy,.15)
    var old: Vector2 = enemy.global_position
    camera.position += Vector2(350,-600)
    camera.force_update_scroll()
    check(enemy.global_position==old,"Camera motion cannot move the octopus in world coordinates")
    advance(enemy,.01)
    check(enemy.global_position.distance_to(old)<4,"Next physics step cannot inherit a camera jump")
    camera.position = Vector2.ZERO
    camera.force_update_scroll()
    enemy.reset()
    enemy._appear(Vector2(-120,-80))
    player.position = Vector2(0,20)
    advance(enemy,.01)
    check(enemy.state==enemy.State.SQUASHING,"Nearby fish starts one readable anticipation")
    advance(enemy,.31)
    check(enemy.state==enemy.State.INKING,"Anticipation leads to reference ink sequence")
    var head_anchor: Vector2 = enemy.global_position
    advance(enemy,.95)
    check(not enemy._sprayed and shots==0,"No instant screen splatter before the jet detaches")
    check(enemy.sprite.frame==5,"Reference jet grows through the full sixth pose")
    check(enemy.global_position.distance_to(head_anchor)<1,"Spraying does not move body due to ink bounds")
    check(is_equal_approx(enemy.sprite.scale.x,.42),"Swim and ink retain identical artwork scale")
    player.position = Vector2(5000,5000)
    advance(enemy,.15)
    check(enemy._sprayed and is_instance_valid(enemy._cloud),"Jet detaches into a world ink cloud at 1.08 seconds")
    var cloud_position: Vector2 = enemy._cloud.global_position
    var cloud_start_scale: float = enemy._cloud.scale.x
    player.position = Vector2(5000,5000)
    advance(enemy,.1)
    check(shots==0,"Distant fish is not inked merely because an animation played")
    check(enemy._cloud.scale.x>cloud_start_scale,"Detached cloud expands smoothly")
    player.global_position = cloud_position
    advance(enemy,.01)
    check(shots==1,"Only contact with visible ink triggers screen splatter")
    advance(enemy,.15)
    check(enemy.state==enemy.State.EXITING,"Spray finishes with a reverse swim, not another attack")
    var before: Vector2 = enemy.global_position
    advance(enemy,.5)
    check((enemy.global_position-before).dot(enemy._jet_direction)<0,"Octopus recoils opposite the locked ink direction")
    check(enemy._cloud.global_position==cloud_position,"Cloud remains in the water as the octopus swims away")
    check(not enemy.is_available(),"Active body or cloud cannot be recycled by scheduler")
    enemy.finish_current_visit()
    advance(enemy,4)
    check(not is_instance_valid(enemy._cloud),"Cloud eventually fades and releases its slot")
    enemy.reset()
    check(not enemy.visible and enemy.visual.rotation==0,"Retry clears rotation, body and ink")
    var ink = load("res://scenes/effects/ocean_ink_overlay.tscn").instantiate()
    root.add_child(ink)
    ink.splash()
    ink.set_process(false)
    check(is_equal_approx(ink.splatter.scale.x,.55),"Screen ink starts small")
    ink._process(.2)
    check(is_equal_approx(ink.splatter.scale.x,1),"Screen ink opens with eased expansion")
    ink._process(3)
    check(is_equal_approx(ink.splatter.modulate.a,1),"Expanded screen ink holds for three seconds")
    ink._process(.5)
    check(absf(ink.splatter.modulate.a-.5)<.01,"Screen ink fades without abrupt clearing")
    ink.reset()
    enemy.queue_free()
    ink.queue_free()
    await process_frame
    print("OCEAN_OCTOPUS_FAILURES=",failures.size())
    quit(0 if failures.is_empty() else 1)
